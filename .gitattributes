# Normalize line endings
* text=auto

# PowerShell and Windows files: CRLF on checkout
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Everything else: LF
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf

# Binary assets
*.png   binary
*.jpg   binary
*.jfif  binary
*.ico   binary
